@model Project.Models.Employeecls
@{
    ViewBag.Title = "company_load";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<h2>Company Registration</h2>
<div>
    @using (Html.BeginForm("company_click", "Unique", FormMethod.Post))
    {
        <div>
            <label>Name:</label>
        </div>
        <div>
            @Html.TextBoxFor(m => m.name)
            @Html.ValidationMessageFor(m => m.name)
        </div>


        <div>
            <label>Address:</label>
        </div>
        <div>
            @Html.TextAreaFor(m => m.addr)
            @Html.ValidationMessageFor(m => m.addr)
        </div>


        <div>
            <label>Phone:</label>
        </div>
        <div>
            @Html.TextBoxFor(m => m.phone)
            @Html.ValidationMessageFor(m => m.phone)
        </div>


        <div>
            <label>Web Address:</label>
        </div>
        <div>
            @Html.TextAreaFor(m => m.webaddr)
            @Html.ValidationMessageFor(m => m.webaddr)
        </div>


        <div>
            <label>Company Description:</label>
        </div>
        <div>
            @Html.TextAreaFor(m => m.desc)
            @Html.ValidationMessageFor(m => m.desc)
        </div>


        <div>
            <label>Username:</label>
        </div>
        <div>
            @Html.TextBoxFor(m => m.username)
        </div>

        <div>
            <label>Password:</label>
        </div>
        <div>
            @Html.PasswordFor(m => m.password)
        </div>

        <div>
            <label>Confirm Password:</label>
        </div>
        <div>
            @Html.PasswordFor(m => m.cpassword)
            @Html.ValidationMessageFor(m => m.cpassword)
        </div>

        <div>
            <input type="submit" value=" Register" />
            @Html.DisplayFor(m => m.compmsg)
        </div>
    }
</div>



