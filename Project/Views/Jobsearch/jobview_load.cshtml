@model Project.Models.Jobsearch
@{
    ViewBag.Title = "Explore Jobs";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Notification Alert -->
@if (TempData["msg"] != null)
{
    <div class="alert-modern alert-modern-info" style="margin-top: 20px;">
        <span class="glyphicon glyphicon-info-sign" style="margin-right: 6px;"></span>
        <strong>Notice:</strong> @TempData["msg"]
    </div>
}

<div style="margin-top: 20px; margin-bottom: 25px;">
    <h2>Explore Career Opportunities</h2>
    <p>Find the best matching jobs across top industries. Filter by skills, required experience, and location.</p>
</div>

<!-- Search Filter Bar -->
<div class="search-filter-card">
    @using (Html.BeginForm("jobsearch_click", "Jobsearch", FormMethod.Post))
    {
        <div class="search-grid">
            <div class="form-group-modern" style="margin-bottom: 0;">
                <label for="skillSearch">Skills / Tech Stack</label>
                @Html.TextBoxFor(m => m.interse.skill, new { @class = "input-modern", id = "skillSearch", placeholder = "e.g. C#, SQL, React..." })
            </div>
            <div class="form-group-modern" style="margin-bottom: 0;">
                <label for="expSearch">Experience</label>
                @Html.TextBoxFor(m => m.interse.exp, new { @class = "input-modern", id = "expSearch", placeholder = "e.g. 2 Years, Fresh..." })
            </div>
            <div class="form-group-modern" style="margin-bottom: 0;">
                <label for="locSearch">Location</label>
                @Html.TextBoxFor(m => m.interse.location, new { @class = "input-modern", id = "locSearch", placeholder = "e.g. Remote, City..." })
            </div>
            <div>
                <button type="submit" class="btn-portal-primary btn-block-portal" style="height: 44px; padding: 10px 20px;">
                    <span class="glyphicon glyphicon-search" style="margin-right: 5px;"></span> Search
                </button>
            </div>
        </div>
    }
</div>

<!-- Search Results Header -->
<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px; flex-wrap: wrap; gap: 10px;">
    <div style="font-size: 15px; font-weight: 600; color: #475569;">
        @if (Model != null && Model.selectjob != null && Model.selectjob.Any())
        {
            <span>Showing <span style="color: #2563eb; font-weight: 700;">@Model.selectjob.Count</span> available positions</span>
        }
        else
        {
            <span>0 jobs found</span>
        }
    </div>
    <div>
        <a href="@Url.Action("jobview_load", "Jobsearch")" class="btn-portal-secondary" style="padding: 6px 14px; font-size: 13px;">
            <span class="glyphicon glyphicon-refresh" style="margin-right: 4px;"></span> Reset All Filters
        </a>
    </div>
</div>

<!-- Results Table / Cards -->
@if (Model != null && Model.selectjob != null && Model.selectjob.Any())
{
    <div class="modern-table-container table-responsive">
        <table class="table modern-table">
            <thead>
                <tr>
                    <th>Job ID</th>
                    <th>Company</th>
                    <th>Required Skills</th>
                    <th>Experience</th>
                    <th>Location</th>
                    <th>Salary</th>
                    <th>Deadline</th>
                    <th>Status</th>
                    <th style="text-align: right;">Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.selectjob)
                {
                    <tr>
                        <td>
                            <strong style="color: #1e293b;">#@item.Job_id</strong>
                        </td>
                        <td>
                            <span style="font-weight: 600; color: #334155;">Company #@item.Company_id</span>
                        </td>
                        <td>
                            <span class="badge-portal badge-portal-skill">@item.skill</span>
                        </td>
                        <td>
                            <span style="color: #475569;">@item.exp</span>
                        </td>
                        <td>
                            <span class="glyphicon glyphicon-map-marker" style="color: #64748b; font-size: 12px; margin-right: 3px;"></span>
                            @item.location
                        </td>
                        <td>
                            @if (item.salary > 0)
                            {
                                <span class="badge-portal badge-portal-salary">$@item.salary.ToString("N0")</span>
                            }
                            else
                            {
                                <span style="color: #94a3b8;">Competitive</span>
                            }
                        </td>
                        <td>
                            <span style="color: #64748b; font-size: 13px;">@item.date</span>
                        </td>
                        <td>
                            @{
                                var isClosed = (item.job_status ?? "").IndexOf("closed", StringComparison.OrdinalIgnoreCase) >= 0;
                            }
                            <span class="badge-portal @(isClosed ? "badge-portal-closed" : "badge-portal-active")">
                                @(string.IsNullOrWhiteSpace(item.job_status) ? "Active" : item.job_status)
                            </span>
                        </td>
                        <td style="text-align: right;">
                            @Html.ActionLink("Apply Now", "app_load", "Apps",
                                new { jid = item.Job_id, cid = item.Company_id },
                                new { @class = "btn-portal-primary", style = "padding: 6px 14px; font-size: 13px;" })
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="portal-card text-center" style="padding: 50px 20px;">
        <div style="font-size: 48px; color: #94a3b8; margin-bottom: 15px;">
            <span class="glyphicon glyphicon-folder-open"></span>
        </div>
        <h3 style="margin-top: 0;">No Job Postings Found</h3>
        <p style="max-width: 450px; margin: 0 auto 20px auto;">We couldn't find any positions matching your search filters. Try clearing your filters or search with different keywords.</p>
        <a href="@Url.Action("jobview_load", "Jobsearch")" class="btn-portal-primary">
            Clear Filters &amp; View All Jobs
        </a>
    </div>
}
