@model Project.Models.Jobcls
@{
    ViewBag.Title = "Post a New Job";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row" style="margin-top: 20px;">
    <div class="col-md-10 col-md-offset-1 col-lg-8 col-lg-offset-2">
        <div class="portal-card">
            <div class="portal-card-header">
                <h2>Post a New Job Opening</h2>
                <p>Fill out the job specifications below to publish your opening to candidates across the portal</p>
            </div>

            @if (Model != null && !string.IsNullOrEmpty(Model.msg))
            {
                <div class="alert-modern alert-modern-success">
                    <span class="glyphicon glyphicon-ok-circle" style="margin-right: 6px;"></span>
                    <strong>Job Successfully Registered!</strong> Your listing is now visible to candidates. <a href="@Url.Action("jobview_load", "Jobsearch")" style="font-weight: 700; text-decoration: underline;">View active listings</a>.
                </div>
            }

            @using (Html.BeginForm("Job_click", "Jobs", FormMethod.Post))
            {
                <div class="form-row-2col">
                    <div class="form-group-modern">
                        <label for="skill">Required Skills &amp; Tech Stack <span style="color: #ef4444;">*</span></label>
                        @Html.TextBoxFor(m => m.skill, new { @class = "input-modern", placeholder = "e.g. C#, .NET, SQL Server, MVC" })
                        @Html.ValidationMessageFor(m => m.skill)
                    </div>
                    <div class="form-group-modern">
                        <label for="exp">Required Experience <span style="color: #ef4444;">*</span></label>
                        @Html.TextBoxFor(m => m.exp, new { @class = "input-modern", placeholder = "e.g. 2 - 4 Years, Mid-level" })
                        @Html.ValidationMessageFor(m => m.exp)
                    </div>
                </div>

                <div class="form-row-2col">
                    <div class="form-group-modern">
                        <label for="loc">Job Location <span style="color: #ef4444;">*</span></label>
                        @Html.TextBoxFor(m => m.loc, new { @class = "input-modern", placeholder = "e.g. New York, NY / Remote" })
                        @Html.ValidationMessageFor(m => m.loc)
                    </div>
                    <div class="form-group-modern">
                        <label for="sal">Annual Salary ($ / Local Currency) <span style="color: #ef4444;">*</span></label>
                        @Html.TextBoxFor(m => m.sal, new { @class = "input-modern", placeholder = "e.g. 75000", type = "number" })
                        @Html.ValidationMessageFor(m => m.sal)
                    </div>
                </div>

                <div class="form-row-2col">
                    <div class="form-group-modern">
                        <label for="ldate">Application Deadline (Last Date) <span style="color: #ef4444;">*</span></label>
                        @Html.TextBoxFor(m => m.ldate, new { @class = "input-modern", placeholder = "YYYY-MM-DD", type = "date" })
                        @Html.ValidationMessageFor(m => m.ldate)
                    </div>
                    <div class="form-group-modern">
                        <label for="status">Job Status</label>
                        @Html.TextBoxFor(m => m.status, new { @class = "input-modern", placeholder = "Active", @Value = (Model != null && !string.IsNullOrEmpty(Model.status)) ? Model.status : "Active" })
                        @Html.ValidationMessageFor(m => m.status)
                    </div>
                </div>

                <div style="margin-top: 30px; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 15px;">
                    <button type="submit" class="btn-portal-primary" style="padding: 12px 30px; font-size: 16px;">
                        Publish Job Opening &raquo;
                    </button>
                    <a href="@Url.Action("Adminhome", "login")" class="btn-portal-secondary">
                        Back to Dashboard
                    </a>
                </div>
            }
        </div>
    </div>
</div>
